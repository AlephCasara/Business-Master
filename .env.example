# Business Master local bootstrap
BM_ENVIRONMENT=local
BM_DATABASE_URL=postgresql://business_master:business_master@127.0.0.1:5432/business_master
BM_ASSET_ROOT=./var/assets

# Zero-cash defaults. Keep at zero until an explicit evidence-backed policy change.
BM_PAID_ADS_BUDGET_DAILY=0
BM_EXTERNAL_AI_API_BUDGET_DAILY=0
BM_CLOUD_GPU_BUDGET_DAILY=0
BM_PAID_SAAS_BUDGET_DAILY=0

BM_EXPLORATION_FRACTION=0.20
BM_MAX_CANDIDATE_ALLOCATION_FRACTION=0.50
BM_MAX_RECONCILE_ACTIONS=100
BM_HUMAN_BATCH_INTERVAL_SECONDS=3600

# Optional OpenAI-compatible local model endpoint.
# BM_LOCAL_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# BM_LOCAL_MODEL_NAME=local-model
